from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.uix.textinput import TextInput
from kivy.uix.popup import Popup
from kivy.uix.scrollview import ScrollView
from kivy.clock import Clock
import threading, time, random
from datetime import datetime

class GapApp(App):
    def build(self):
        self.bal = 10000.0
        self.running = False
        self.mt5_code = ""
        self.use_custom = False
        self.trades = 0
        
        root = BoxLayout(orientation='vertical', padding=8, spacing=6)
        
        # Title
        root.add_widget(Label(text='VOL 100 GAP + CUSTOM STRATEGY', font_size=18, bold=True, size_hint_y=0.08))
        
        # Buttons row
        row = BoxLayout(size_hint_y=0.10, spacing=5)
        b1 = Button(text='PASTE MT5 CODE', background_color=(1,0.6,0,1))
        b1.bind(on_press=self.open_paste)
        self.b_toggle = Button(text='USE: ORIGINAL GAP', background_color=(0.5,0.5,0.5,1))
        self.b_toggle.bind(on_press=self.toggle_code)
        row.add_widget(b1)
        row.add_widget(self.b_toggle)
        root.add_widget(row)
        
        # Balance
        self.lbl_bal = Label(text=f'Balance: ${self.bal:.2f}', color=(0,1,0,1), font_size=16, size_hint_y=0.07)
        root.add_widget(self.lbl_bal)
        self.lbl_status = Label(text='Status: READY - Tap START', size_hint_y=0.06)
        root.add_widget(self.lbl_status)
        
        # Log
        self.lbl_log = Label(text='Welcome!\n1. Paste MT5 code if you have it\n2. Tap START for 24/7 bot\n', size_hint_y=None, font_size=11, halign='left', valign='top')
        self.lbl_log.bind(texture_size=self.lbl_log.setter_size)
        scroll = ScrollView(size_hint_y=0.55)
        scroll.add_widget(self.lbl_log)
        root.add_widget(scroll)
        
        # Start Stop
        btns = BoxLayout(size_hint_y=0.12, spacing=8)
        btn_start = Button(text='START 24/7', background_color=(0,0.8,0,1))
        btn_start.bind(on_press=self.start_bot)
        btn_stop = Button(text='STOP', background_color=(0.8,0,0,1))
        btn_stop.bind(on_press=self.stop_bot)
        btns.add_widget(btn_start)
        btns.add_widget(btn_stop)
        root.add_widget(btns)
        
        return root
    
    def open_paste(self, *args):
        box = BoxLayout(orientation='vertical', padding=10, spacing=5)
        box.add_widget(Label(text='Paste your MT5 Gap Strategy Code here:', size_hint_y=0.1))
        self.input_code = TextInput(multiline=True, size_hint_y=0.7, text=self.mt5_code, hint_text='Paste MQL5 code here...')
        box.add_widget(self.input_code)
        btn_row = BoxLayout(size_hint_y=0.2, spacing=5)
        btn_save = Button(text='SAVE CODE', background_color=(0,0.8,0,1))
        btn_save.bind(on_press=self.save_code)
        btn_close = Button(text='CLOSE')
        btn_close.bind(on_press=lambda x: self.popup.dismiss())
        btn_row.add_widget(btn_save)
        btn_row.add_widget(btn_close)
        box.add_widget(btn_row)
        self.popup = Popup(title='MT5 Code Editor', content=box, size_hint=(0.95, 0.9))
        self.popup.open()
    
    def save_code(self, *args):
        self.mt5_code = self.input_code.text
        self.use_custom = True
        self.b_toggle.text = "USE: CUSTOM CODE"
        self.b_toggle.background_color = (0,0.8,0,1)
        self.log(f"Custom MT5 code saved! Length: {len(self.mt5_code)} chars")
        self.popup.dismiss()
    
    def toggle_code(self, *args):
        self.use_custom = not self.use_custom
        if self.use_custom:
            self.b_toggle.text = "USE: CUSTOM CODE"
            self.b_toggle.background_color = (0,0.8,0,1)
            self.log("Switched to CUSTOM strategy")
        else:
            self.b_toggle.text = "USE: ORIGINAL GAP"
            self.b_toggle.background_color = (0.5,0.5,0.5,1)
            self.log("Switched to ORIGINAL Gap strategy")
    
    def log(self, msg):
        t = datetime.now().strftime("%H:%M:%S")
        def update(dt):
            self.lbl_log.text += f"{t} - {msg}\n"
        Clock.schedule_once(update)
    
