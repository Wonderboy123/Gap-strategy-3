  self.log_label=Label(text='',size_hint_y=None,font_size=11);self.log_label.bind(texture_size=self.log_label.setter_size)
  scroll=ScrollView(size_hint_y=0.5);scroll.add_widget(self.log_label);root.add_widget(scroll)
  btn=BoxLayout(size_hint_y=0.1,spacing=8);btn.add_widget(Button(text='START 24/7',background_color=(0,0.8,0,1),on_press=self.start));btn.add_widget(Button(text='STOP',background_color=(0.8,0,0,1),on_press=self.stop));root.add_widget(btn)
  return root
 def open_editor(self,*a):
  box=BoxLayout(orientation='vertical',spacing=5,padding=10);box.add_widget(Label(text='Paste MT5 code here:'))
  self.code_input=TextInput(multiline=True,size_hint_y=0.8);box.add_widget(self.code_input)
  btns=BoxLayout(size_hint_y=0.15,spacing=5);btns.add_widget(Button(text='SAVE',background_color=(0,0.8,0,1),on_press=self.save_code));btns.add_widget(Button(text='CLOSE',on_press=lambda x:self.popup.dismiss()));box.add_widget(btns)
  self.popup=Popup(title='PASTE MT5 CODE',content=box,size_hint=(0.95,0.9));self.popup.open()
 def save_code(self,*a):self.custom_code=self.code_input.text;self.use_custom=True;self.btn_toggle.text="USE: CUSTOM CODE";self.log(f"Saved {len(self.custom_code)} chars");self.popup.dismiss()
 def toggle(self,*a):self.use_custom=not self.use_custom;self.btn_toggle.text="USE: CUSTOM CODE" if self.use_custom else "USE: ORIGINAL";self.log(f"Switched to {'CUSTOM' if self.use_custom else 'ORIGINAL'}")
 def log(self,msg):self.log_label.text+=f"{datetime.now().strftime('%H:%M:%S')} {msg}\n"
 def run_loop(self):
  while self.running:
   buy=random.choice([True,False]);profit=4.0 if random.random()>0.45 else -2.5;self.demo_bal+=profit;self.lbl_bal.text=f'Balance: ${self.demo_bal:.2f}';self.log(f"{'CUSTOM' if self.use_custom else 'GAP'} {'BUY' if buy else 'SELL'} {profit}");time.sleep(3)
 def start(self,*a):
  if self.running:return
  self.running=True;threading.Thread(target=self.run_loop,daemon=True).start();self.log("STARTED 24/7")
 def stop(self,*a):self.running=False;self.log("STOPPED")
GapApp().run()
