from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.uix.textinput import TextInput
from kivy.uix.popup import Popup
from kivy.uix.scrollview import ScrollView
import threading, time, random
from datetime import datetime
class GapApp(App):
 def build(self):
  self.demo_bal=10000.0;self.running=False;self.custom_code="";self.use_custom=False
  root=BoxLayout(orientation='vertical',padding=8,spacing=6)
  root.add_widget(Label(text='VOL 100 GAP + CUSTOM CODE',font_size=20,bold=True,size_hint_y=0.08))
  code_box=BoxLayout(size_hint_y=0.08,spacing=5)
  b1=Button(text='PASTE MT5 CODE',background_color=(1,0.6,0,1));b1.bind(on_press=self.open_editor)
  b2=Button(text='USE: ORIGINAL',background_color=(0.5,0.5,0.5,1));b2.bind(on_press=self.toggle)
  self.btn_toggle=b2;code_box.add_widget(b1);code_box.add_widget(b2);root.add_widget(code_box)
  self.lbl_bal=Label(text=f'Balance: ${self.demo_bal:.2f}',font_size=17,color=(0,1,0,1),size_hint_y=0.07);root.add_widget(self.lbl_bal)
